{
  "rules": {
    ".read": false,
    ".write": false,
    "views": {
      ".read": true,
      "total": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      },
      "days": {
        "$day": {
          ".write": "$day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "$other": { ".validate": false }
    }
  }
}
